---
import { getCollection } from "astro:content";

interface Props {
  category?: string;
  heading?: string;
}
const { category, heading = "Forms and documents" } = Astro.props;
const docs = (
  await getCollection(
    "documents",
    (d) => !category || d.data.category === category,
  )
).toSorted(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    b.data.date.valueOf() - a.data.date.valueOf(),
);
const kind = (file: string) =>
  file.toLowerCase().endsWith(".pdf") ? "PDF" : "image";
---

{docs.length > 0 && (
  <section>
    <h2>{heading}</h2>
    <ul class="tasks">
      {docs.map((d) => (
        <li>
          <a
            href={d.data.file}
            lang={d.data.language === "es" ? "es" : undefined}
          >
            <strong>{d.data.title}</strong>
            <span>
              {d.data.summary} ({kind(d.data.file)}
              {d.data.language === "es" && ", Spanish"})
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

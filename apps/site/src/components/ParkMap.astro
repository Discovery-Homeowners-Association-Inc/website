---
import type { MapPlace } from "@dhoa/shared";
import mapSvg from "../assets/discovery-map.svg?raw";
import { onTheMap, project } from "../lib/map.ts";

interface Props {
  places: MapPlace[];
}

/*
 * The parks, drawn on the neighborhood map.
 *
 * The map itself is the same SVG the home page uses, so this costs no extra
 * download and follows the site's palette into dark mode. The markers are
 * ordinary elements laid over it rather than shapes spliced into it: the SVG
 * scales to the width of its box, so a marker placed at a percentage of that
 * box lands on the spot the projection gives, and stays an element that can
 * be styled, focused and clicked.
 *
 * Each marker is a link to its entry in the full list. Pick one and the panel
 * beside the map says which park it is; with no JavaScript the link still
 * works, jumping to the same park in the list below. The list is the thing
 * that holds the information -- the map is a nicer way to get at it -- so it
 * is always there, folded away rather than spelled out twice.
 */
const { places } = Astro.props;

/*
 * The map is drawn to hold the whole street network with room to spare. The
 * parks sit inside x 110-781, y 180-1184 of it, so the picture is cropped to
 * them with a margin: the same drawing, closer in, which is what makes twenty
 * markers legible rather than crowded into the middle.
 */
const VIEW = { x: 50, y: 110, width: 790, height: 1150 };

/*
 * Two markers can sit closer together than a marker is wide -- the two parks
 * off Foresight Lane are 31m apart, and the pool and the court beside it 37m.
 * Drawn where they are, each eats into the other's target, which is both a
 * nuisance to tap and a failure of WCAG 2.2's 24px minimum.
 *
 * So markers that collide are eased apart until they do not, by the least
 * that works. This moves the drawing, never the coordinate: the setting the
 * board edits still says where the park is. Seventeen of the twenty-eight do
 * not move at all and the furthest goes 20m, which is inside the error these
 * positions already carry -- see apps/site/scripts/park-positions.mjs -- so
 * the drawing claims no more precision than it did before.
 */
const APART = 58; // in the picture's own units; a marker is about 55 across

const placed = places.map((place) => project(place.lat, place.lon));
for (let pass = 0; pass < 100; pass++) {
  let collided = false;
  for (let a = 0; a < placed.length; a++) {
    for (let b = a + 1; b < placed.length; b++) {
      const dx = placed[b].x - placed[a].x;
      const dy = placed[b].y - placed[a].y;
      const gap = Math.hypot(dx, dy);
      if (gap >= APART) continue;
      collided = true;
      // Straight apart, or along x when they are exactly on top of each other.
      const ux = gap === 0 ? 1 : dx / gap;
      const uy = gap === 0 ? 0 : dy / gap;
      const push = (APART - gap) / 2;
      placed[a].x -= ux * push;
      placed[a].y -= uy * push;
      placed[b].x += ux * push;
      placed[b].y += uy * push;
    }
  }
  if (!collided) break;
}

const marked = places.map((place, index) => ({
  ...place,
  id: `place-${index}`,
  drawn: onTheMap(place.lat, place.lon),
  left: ((placed[index].x - VIEW.x) / VIEW.width) * 100,
  top: ((placed[index].y - VIEW.y) / VIEW.height) * 100,
}));

/** "Park 4, off Vision Lane" -- what the marker is called out loud. */
const spoken = (place: { label: string; note: string }) =>
  place.note
    ? `${place.label}, ${place.note[0].toLowerCase()}${place.note.slice(1)}`
    : place.label;

const cropped = mapSvg.replace(
  /viewBox="[^"]*"/,
  `viewBox="${VIEW.x} ${VIEW.y} ${VIEW.width} ${VIEW.height}"`,
);
---

<figure class="parkmap">
  <div class="parkmap__picture">
    <Fragment set:html={cropped} />
    <ul class="parkmap__marks">
      {marked
        .filter((p) => p.drawn)
        .map((p) => (
          <li>
            <a
              href={`#${p.id}`}
              data-place={p.id}
              data-label={p.label}
              data-note={p.note}
              aria-label={spoken(p)}
              class:list={["parkmap__mark", `parkmap__mark--${p.kind}`]}
              style={`left:${p.left.toFixed(2)}%;top:${p.top.toFixed(2)}%`}
            >
              {p.kind === "park" ? p.number : ""}
            </a>
          </li>
        ))}
    </ul>
  </div>

  <figcaption class="parkmap__key">
    <p class="parkmap__detail" data-detail>
      <b data-detail-label>Pick a marker</b>
      <span data-detail-note>to see which park it is.</span>
    </p>
    <ul class="parkmap__legend">
      <li>
        <span class="parkmap__swatch parkmap__swatch--park" aria-hidden="true">
          7
        </span>
        The twenty parks, numbered as on the association's own map
      </li>
      <li>
        <span
          class="parkmap__swatch parkmap__swatch--amenity"
          aria-hidden="true"
        />
        What the neighborhood shares
      </li>
    </ul>
    <details class="group parkmap__all">
      <summary>Every park and amenity</summary>
      <ul>
        {marked.map((p) => (
          <li id={p.id} data-place={p.id} class="parkmap__entry">
            <b>{p.kind === "park" ? p.number : "•"}</b>
            <span>
              {p.label}
              {p.note && <small>{p.note}</small>}
            </span>
          </li>
        ))}
      </ul>
    </details>
    <p class="parkmap__note">
      Positions are approximate, taken from the association's own park map.
    </p>
  </figcaption>
</figure>

<script>
  /*
   * Pick a marker and the panel says which park it is. Pointing at one shows
   * it without committing, so a mouse can read the whole map without clicking
   * twenty times; moving away falls back to whatever was actually picked.
   *
   * None of this is needed to read the page. With no JavaScript every marker
   * is still a link to the same park in the list below it.
   */
  for (const figure of document.querySelectorAll(".parkmap")) {
    const detail = figure.querySelector("[data-detail]");
    const name = figure.querySelector("[data-detail-label]");
    const note = figure.querySelector("[data-detail-note]");
    if (!detail || !name || !note) continue;

    const prompt = {
      label: name.textContent ?? "",
      note: note.textContent ?? "",
    };
    const marks = figure.querySelectorAll<HTMLElement>(".parkmap__mark");
    let picked: HTMLElement | null = null;

    const show = (mark: HTMLElement | null) => {
      name.textContent = mark?.dataset.label ?? prompt.label;
      note.textContent = mark?.dataset.note ?? prompt.note;
      detail.classList.toggle("is-chosen", Boolean(mark));
      for (const other of marks)
        other.classList.toggle("is-lit", other === mark);
      for (const entry of figure.querySelectorAll(".parkmap__entry"))
        entry.classList.toggle(
          "is-lit",
          Boolean(mark) &&
            entry.getAttribute("data-place") === mark?.dataset.place,
        );
    };

    for (const mark of marks) {
      mark.addEventListener("click", (event) => {
        event.preventDefault();
        picked = mark === picked ? null : mark;
        show(picked);
      });
      mark.addEventListener("pointerenter", () => show(mark));
      mark.addEventListener("pointerleave", () => show(picked));
      mark.addEventListener("focus", () => show(mark));
      mark.addEventListener("blur", () => show(picked));
    }
  }
</script>

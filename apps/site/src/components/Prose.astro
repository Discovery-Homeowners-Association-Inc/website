---
import { render } from "astro:content";
import { pageEntry } from "../lib/pages";

interface Props {
  id: string;
  part?: "intro" | "rest";
}
const { id, part } = Astro.props;
const entry = await pageEntry(part ? `${id}--${part}` : id);
const { Content } = await render(entry);
---

{entry.body && (
  <div class="prose">
    <Content />
  </div>
)}

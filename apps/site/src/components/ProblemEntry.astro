---
import { email, officeTel, org, telHref } from "../lib/data";

interface Props {
  entry: (typeof import("../lib/data").problems)[number];
}
const { entry: e } = Astro.props;
const phone = e.phone_key === "office" ? org.office.phone : e.phone;
const href = e.phone_key === "office" ? officeTel() : telHref(e.phone);
---

<li>
  <strong>{e.issue}</strong>
  <span>{e.contact}</span>
  {phone && (
    <div>
      <a href={href}>{phone}</a>
    </div>
  )}
  {e.email_key && (
    <div>
      <a href={`mailto:${email(e.email_key)}`}>{email(e.email_key)}</a>
    </div>
  )}
  {e.note && <p class="muted">{e.note}</p>}
</li>

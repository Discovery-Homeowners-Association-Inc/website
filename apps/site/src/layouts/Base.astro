---
import "../styles/global.css";
import SiteHeader from "@dhoa/design/SiteHeader.astro";
import fontDisplay from "@dhoa/design/fonts/bricolage-grotesque.woff2?url";
import fontBody from "@dhoa/design/fonts/atkinson-hyperlegible-next.woff2?url";
import { officeTel, org } from "../lib/data";

interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = `${org.legal_name} in ${org.locality}, ${org.state}.`,
} = Astro.props;
const path = Astro.url.pathname;
// See astro.config.mjs: the temporary address stays out of search results.
const temporaryAddress = Astro.site?.hostname.endsWith(".workers.dev") ?? false;
const fullTitle =
  path === "/" ? org.legal_name : `${title} | ${org.short_name}`;

const nav = [
  { href: "/meetings/", label: "Meetings" },
  { href: "/amenities/", label: "Amenities" },
  { href: "/rules/", label: "Rules & requests" },
  { href: "/documents/", label: "Documents" },
  { href: "/news/", label: "News & events" },
  { href: "/contact/", label: "Contact" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={new URL(path, Astro.site)} />
    {temporaryAddress && <meta name="robots" content="noindex, nofollow" />}
    <link
      rel="preload"
      href={fontDisplay}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={fontBody}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#1f4fa8" />
    <link
      rel="alternate"
      type="text/calendar"
      title="Discovery HOA calendar"
      href="/calendar.ics"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <SiteHeader
      title="Discovery Homeowners"
      subtitle={`${org.locality}, ${org.state}`}
      nav={nav}
      path={path}
    >
      <a class="button" href="/dues/" slot="action">
        Pay dues
      </a>
    </SiteHeader>

    <main id="main" class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div>
          <h2>{org.legal_name}</h2>
          <address>
            Office:{" "}
            {`${org.office.street}, ${org.office.city}, ${org.office.state} ${org.office.zip}`}
            <br />
            Mail: {org.office.mailing}
            <br />
            Phone: <a href={officeTel()}>{org.office.phone}</a>. Fax:{" "}
            {org.office.fax}
            <br />
            Email: <a href={`mailto:${org.office.email}`}>{org.office.email}</a>
          </address>
        </div>
        <div>
          <h2>The neighborhood</h2>
          <ul>
            <li>
              <a href="/about/">About Discovery</a>
            </li>
            <li>
              <a href="/about/history/">History</a>
            </li>
            <li>
              <a href="/board/">The board</a>
            </li>
            <li>
              <a href="/board/projects/">Projects</a>
            </li>
            <li>
              <a href="/contact/committees/">Committees</a>
            </li>
          </ul>
        </div>
        <div>
          <h2>Help</h2>
          <ul>
            <li>
              <a href="/rules/report-a-problem/">Report a problem</a>
            </li>
            <li>
              <a href="/contact/community-links/">Community links</a>
            </li>
            <li>
              <a href="/calendar.ics">Subscribe to the calendar</a>
            </li>
            <li>
              <a href="/rss.xml">News feed (RSS)</a>
            </li>
            <li>
              <a href="/privacy/">Privacy</a>
            </li>
            <li>
              <a href="/terms/">Terms of use</a>
            </li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>

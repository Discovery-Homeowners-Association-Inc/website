---
import { getCollection } from "astro:content";
import { DOCUMENT_CATEGORIES, DOCUMENT_CATEGORY_LABEL } from "@dhoa/shared";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Prose from "../../components/Prose.astro";
import DocumentList from "../../components/DocumentList.astro";
import { page } from "../../lib/pages";

const p = await page("documents");
const order: readonly (typeof DOCUMENT_CATEGORIES)[number][] = [
  "governing",
  "newsletters",
  "minutes",
  "acc",
  "pool",
  "rec-center",
  "rv-lot",
  "parks",
  "trash",
  "general",
] as const;
const unordered = DOCUMENT_CATEGORIES.filter((c) => !order.includes(c));
if (unordered.length)
  throw new Error(
    `documents: no position for ${unordered.join(", ")}. Add them to order in this file.`,
  );
const present = new Set<string>(
  (await getCollection("documents")).map((d) => d.data.category),
);
---

<Base title={p.title} description={p.summary}>
  <PageHead title={p.title} summary={p.summary} />
  <Prose id="documents" />
  {order
    .filter((k) => present.has(k))
    .map((k) => (
      <DocumentList category={k} heading={DOCUMENT_CATEGORY_LABEL[k]} />
    ))}
</Base>

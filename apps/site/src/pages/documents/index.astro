---
import { getCollection } from "astro:content";
import { DOCUMENT_CATEGORIES, DOCUMENT_CATEGORY_LABEL } from "@dhoa/shared";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Prose from "../../components/Prose.astro";
import DocumentList from "../../components/DocumentList.astro";
import { page } from "../../lib/pages";

const p = await page("documents");
const names: Record<(typeof DOCUMENT_CATEGORIES)[number], string> =
  DOCUMENT_CATEGORY_LABEL;
const order = [
  "governing",
  "newsletters",
  "minutes",
  "acc",
  "pool",
  "rec-center",
  "rv-lot",
  "parks",
  "trash",
  "general",
] as const;
const present = new Set<string>(
  (await getCollection("documents")).map((d) => d.data.category),
);
---

<Base title={p.title} description={p.summary}>
  <PageHead title={p.title} summary={p.summary} />
  <Prose id="documents" />
  {order
    .filter((k) => present.has(k))
    .map((k) => (
      <DocumentList category={k} heading={names[k]} />
    ))}
</Base>

---
import SectionIndex from "../../components/SectionIndex.astro";
import { board } from "../../lib/data";

const sub = [
  {
    href: "/about/history/",
    label: "History",
    note: "Frederick County's first planned community, 1972",
  },
  {
    href: "/about/welcome-committee/",
    label: "Welcome Committee",
    note: "A friendly face for new neighbors",
  },
  {
    href: "/board/",
    label: "The board",
    note: `${board.members.length} neighbors, elected by the membership`,
  },
  {
    href: "/board/projects/",
    label: "Projects",
    note: "What the association is working on",
  },
];
---

<SectionIndex id="about" items={sub} />

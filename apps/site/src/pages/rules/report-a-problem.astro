---
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Prose from "../../components/Prose.astro";
import ProblemEntry from "../../components/ProblemEntry.astro";
import { problems } from "../../lib/data";
import { page } from "../../lib/pages";

const p = await page("report-a-problem");

/*
 * Urgent first, in a warning callout, then grouped by the kind of problem.
 * The page copy used to carry its own "call 911" aside above a "Right away"
 * section saying the same thing; one place now, and the entry is the setting.
 */
const urgent = problems.filter((e) => e.urgent);
const rest = problems.filter((e) => !e.urgent);
const categories = [...new Set(rest.map((e) => e.category))];
---

<Base title={p.title} description={p.summary}>
  <PageHead
    title={p.title}
    summary={p.summary}
    crumbs={[{ href: "/rules/", label: "Rules & requests" }]}
  />
  <Prose id="report-a-problem" />
  {urgent.length > 0 && (
    <section class="callout callout--warning" aria-labelledby="urgent-title">
      <h2 id="urgent-title" class="first">
        Right away
      </h2>
      <ul class="people problems">
        {urgent.map((e) => (
          <ProblemEntry entry={e} />
        ))}
      </ul>
    </section>
  )}
  {categories.map((category) => (
    <section>
      <h2>{category}</h2>
      <ul class="people problems">
        {rest
          .filter((e) => e.category === category)
          .map((e) => (
            <ProblemEntry entry={e} />
          ))}
      </ul>
    </section>
  ))}
</Base>

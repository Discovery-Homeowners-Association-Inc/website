---
import SectionIndex from "../../components/SectionIndex.astro";
import { parks } from "../../lib/data";
---

<SectionIndex
  id="amenities"
  items={[
    {
      href: "/amenities/pool/",
      label: "Community pool",
      note: "Season dates, hours, fees, and rules",
    },
    {
      href: "/amenities/recreation-center/",
      label: "Recreation Center",
      note: "Rent it for a party or a meeting",
    },
    {
      href: "/amenities/rv-lot/",
      label: "RV lot",
      note: "Storage for boats, trailers, and RVs",
    },
    {
      href: "/amenities/parks/",
      label: "Parks and playgrounds",
      note: `${parks.count} parks, inspected every year`,
    },
  ]}
/>

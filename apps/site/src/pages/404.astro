---
import Base from "../layouts/Base.astro";
import PageHead from "../components/PageHead.astro";
import { org, telHref } from "../lib/data";
---

<Base title="Page not found">
  <PageHead
    title="That page is not here"
    summary="It may have moved when the site was rebuilt."
  />
  <p>
    Try the <a href="/">home page</a>, the{" "}
    <a href="/documents/">documents library</a>, or call the office at{" "}
    <a href={telHref(org.office.phone)}>{org.office.phone}</a>.
  </p>
</Base>

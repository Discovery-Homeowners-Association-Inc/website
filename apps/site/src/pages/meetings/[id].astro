---
import { MEETING_LABEL, todayInNewYork } from "@dhoa/shared";
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import AttendingPanel from "../../components/AttendingPanel.astro";
import { org } from "../../lib/data";
import { longDate } from "../../lib/dates";

export async function getStaticPaths() {
  const records = await getCollection("meetings");
  return records.map((r) => ({ params: { id: r.id }, props: { record: r } }));
}

const { record } = Astro.props;
const m = record.data;
const title = `${MEETING_LABEL[m.type]}, ${longDate(m.date)}`;

/*
 * A meeting keeps its page after it is called off or held: the listings drop
 * it, but this is the address on a calendar entry or in an old email, so it is
 * exactly the page someone arrives at. It used to say "The agenda is posted
 * about a week before the meeting" either way, which sends a resident to a
 * meeting that is not happening.
 */
const canceled = m.status === "canceled";
const past = !canceled && m.date < todayInNewYork();
---

<Base
  title={title}
  description={`Agenda for the ${MEETING_LABEL[m.type].toLowerCase()} on ${longDate(m.date)}.`}
>
  <PageHead
    title={canceled ? `Canceled: ${title}` : title}
    summary={`${m.time}, ${m.location}`}
    crumbs={[{ href: "/meetings/", label: "Meetings" }]}
  />
  <div class="with-aside">
    <div class="prose">
      {canceled && (
        <p class="callout callout--warning">
          This meeting was canceled. See{" "}
          <a href="/meetings/">the meetings page</a> for the next one.
        </p>
      )}
      {m.agenda.length > 0 ? (
        <section aria-labelledby="agenda-title">
          <h2 id="agenda-title" class="first">
            Agenda
          </h2>
          <ol>
            {m.agenda.map((item) => (
              <li>
                <strong>{item.title}</strong>
                {item.detail && <p class="muted">{item.detail}</p>}
              </li>
            ))}
          </ol>
        </section>
      ) : canceled ? null : past ? (
        <p>No agenda was posted for this meeting.</p>
      ) : (
        <p>The agenda is posted about a week before the meeting.</p>
      )}
      <p class="callout">
        Approved minutes are posted in the{" "}
        <a href={org.external.payhoa.portal_url}>resident portal</a> after the
        board votes on them.
      </p>
    </div>
    <AttendingPanel />
  </div>
</Base>

---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import { longDate } from "../../lib/dates";

export async function getStaticPaths() {
  const records = await getCollection("meetings");
  return records.map((r) => ({ params: { id: r.id }, props: { record: r } }));
}

const { record } = Astro.props;
const m = record.data;
const { Content } = await render(record);
const typeLabel = {
  board: "Board meeting",
  annual: "Annual meeting",
  special: "Special meeting",
  "pool-rec": "Pool & Recreation Committee meeting",
};
const title = `${typeLabel[m.type]}, ${longDate(m.date)}`;
---

<Base
  title={title}
  description={`Agenda${m.minutes ? " and approved minutes" : ""} for the ${title.toLowerCase()}.`}
>
  <PageHead
    title={title}
    summary={`${m.time}, ${m.location}`}
    crumbs={[{ href: "/meetings/", label: "Meetings" }]}
  />
  <div class="prose">
    {m.agenda && (
      <section aria-labelledby="agenda-title">
        <h2 id="agenda-title" class="first">
          Agenda
        </h2>
        <ol>
          {m.agenda.map((item) => (
            <li>
              <strong>{item.title}</strong>
              {item.detail && <p class="muted">{item.detail}</p>}
            </li>
          ))}
        </ol>
      </section>
    )}
    {m.minutes ? (
      <section aria-labelledby="minutes-title">
        <h2 id="minutes-title">Minutes</h2>
        <p class="callout">
          Approved by the board on {longDate(m.minutes.approved_on)} (
          {m.minutes.vote.yes} in favor, {m.minutes.vote.no} against,{" "}
          {m.minutes.vote.abstain} abstaining).
        </p>
        <p>
          <strong>Present:</strong> {m.minutes.present.join(", ")}.
          {m.minutes.absent.length > 0 && (
            <>
              {" "}
              <strong>Absent:</strong> {m.minutes.absent.join(", ")}.
            </>
          )}
        </p>
        <Content />
      </section>
    ) : (
      <p class="muted">
        Minutes are posted after the board approves them, usually at the next
        meeting.
      </p>
    )}
  </div>
</Base>

---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import { org } from "../../lib/data";
import { longDate } from "../../lib/dates";

export async function getStaticPaths() {
  const records = await getCollection("meetings");
  return records.map((r) => ({ params: { id: r.id }, props: { record: r } }));
}

const { record } = Astro.props;
const m = record.data;
const typeLabel = {
  board: "Board meeting",
  annual: "Annual meeting",
  special: "Special meeting",
  "pool-rec": "Pool & Recreation Committee meeting",
};
const title = `${typeLabel[m.type]}, ${longDate(m.date)}`;
---

<Base title={title} description={`Agenda for the ${title.toLowerCase()}.`}>
  <PageHead
    title={title}
    summary={`${m.time}, ${m.location}`}
    crumbs={[{ href: "/meetings/", label: "Meetings" }]}
  />
  <div class="prose">
    {m.agenda ? (
      <section aria-labelledby="agenda-title">
        <h2 id="agenda-title" class="first">
          Agenda
        </h2>
        <ol>
          {m.agenda.map((item) => (
            <li>
              <strong>{item.title}</strong>
              {item.detail && <p class="muted">{item.detail}</p>}
            </li>
          ))}
        </ol>
      </section>
    ) : (
      <p>The agenda is posted about a week before the meeting.</p>
    )}
    <p class="callout">
      Approved minutes are posted in the{" "}
      <a href={org.external.payhoa.portal_url}>resident portal</a> after the
      board votes on them.
    </p>
  </div>
</Base>

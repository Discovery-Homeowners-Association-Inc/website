---
import { todayInNewYork } from "@dhoa/shared";
import Base from "../../layouts/Base.astro";
import PageHead from "../../components/PageHead.astro";
import Prose from "../../components/Prose.astro";
import { email, org } from "../../lib/data";
import { boardMeetings } from "../../lib/calendar";
import { dayOfMonth, longDate, monthShort } from "../../lib/dates";
import { page } from "../../lib/pages";

const p = await page("meetings");
const upcoming = await boardMeetings(todayInNewYork(), 6);
---

<Base title={p.title} description={p.summary}>
  <PageHead title={p.title} summary={p.summary} />
  <div class="with-aside">
    <div>
      <section aria-labelledby="upcoming-title">
        <h2 id="upcoming-title" class="first">
          Upcoming board meetings
        </h2>
        <ul class="dated">
          {upcoming.map((m) => (
            <li>
              <time datetime={m.date}>
                {monthShort(m.date)}
                <span>{dayOfMonth(m.date)}</span>
              </time>
              <div>
                <h3>
                  <a href={m.href}>{longDate(m.date)}</a>
                </h3>
                <p>
                  {m.time}, {m.location}
                  {m.agendaPublished
                    ? ". The agenda is posted."
                    : ". The agenda is posted about a week before."}
                  {m.note && ` ${m.note}`}
                </p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section aria-labelledby="minutes-title">
        <h2 id="minutes-title">Minutes</h2>
        <p class="prose">
          {org.external.payhoa.minutes_note} They are added after the board
          votes to approve them, usually at the following month's meeting.
        </p>
        <p>
          <a class="button button--quiet" href={org.external.payhoa.portal_url}>
            Open the resident portal
          </a>
        </p>
        <p class="muted">
          No portal account yet? <a href="/dues/">How to set one up</a>.
        </p>
      </section>

      <Prose id="meetings" />
    </div>
    <aside class="panel">
      <h2>Attending</h2>
      <dl>
        <dt>When</dt>
        <dd>
          {org.meetings.board.rule}, {org.meetings.board.time}
        </dd>
        <dt>Where</dt>
        <dd>
          {org.meetings.board.location}, {org.office.street}
        </dd>
        <dt>Who</dt>
        <dd>{org.meetings.board.open_to}</dd>
        <dt>Add an item to the agenda</dt>
        <dd>
          <a href={`mailto:${email("general")}`}>{email("general")}</a>
        </dd>
      </dl>
      <p>
        <a href="/calendar.ics">Add meetings to your calendar</a>
      </p>
    </aside>
  </div>
</Base>

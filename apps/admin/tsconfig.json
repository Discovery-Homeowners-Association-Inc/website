{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2023"],
    "types": [
      "@cloudflare/vitest-pool-workers/types",
      "./worker-configuration.d.ts"
    ],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true
  },
  "include": [
    "src",
    "test",
    "scripts",
    "vitest.config.ts",
    "worker-configuration.d.ts"
  ]
}

---
import Admin from "../../layouts/Admin.astro";
import { KINDS } from "../../lib/content.ts";
---

<Admin title="Content">
  <h1>Content</h1>
  <p class="lede">
    Everything written on the public site, by kind. Facts such as phone numbers,
    hours and fees are under Site settings.
  </p>
  <ul class="tasks">
    {Object.values(KINDS).map((k) => (
      <li>
        <a href={k.path}>
          <strong>{k.many}</strong>
          <span>{k.intro}</span>
        </a>
      </li>
    ))}
  </ul>
</Admin>

---
import "../styles/admin.css";
import SiteHeader from "@dhoa/design/SiteHeader.astro";
import fontDisplay from "@dhoa/design/fonts/bricolage-grotesque.woff2?url";
import fontBody from "@dhoa/design/fonts/atkinson-hyperlegible-next.woff2?url";

interface Props {
  title: string;
  bare?: boolean;
}
const { title, bare = false } = Astro.props;
const path = Astro.url.pathname;
const nav = [
  { href: "/", label: "Home" },
  { href: "/content/", label: "Content" },
  { href: "/meetings/", label: "Meetings" },
  { href: "/roster/", label: "Roster" },
  { href: "/people/", label: "Accounts", adminOnly: true },
  { href: "/settings/", label: "Settings", adminOnly: true },
  { href: "/export/", label: "Export" },
  { href: "/help/", label: "Help" },
];
const current = (href: string) =>
  (href === "/" ? path === "/" : path.startsWith(href)) ? "page" : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title} | Board administration</title>
    <link
      rel="preload"
      href={fontDisplay}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href={fontBody}
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Before the page is drawn: show admin-only links if this browser last
      // saw an administrator signed in. Checked again against the API below.
      try {
        if (localStorage.getItem("dhoa:is-admin") === "1") {
          document.documentElement.setAttribute("data-admin", "");
        }
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    {!bare && (
      <SiteHeader
        class="admin-header"
        title="Discovery Homeowners"
        subtitle="Board administration"
        nav={nav}
        path={path}
        exactRoot
      >
        <div class="admin-you" slot="action">
          <a
            href="/profile/"
            aria-current={current("/profile/")}
            title="Your profile"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="8" r="3.6" />
              <path d="M4.8 20a7.2 7.2 0 0 1 14.4 0" />
            </svg>
            <span class="visually-hidden">Your profile</span>
          </a>
          <form method="post" action="/api/auth/sign-out" data-sign-out>
            <button class="button button--quiet button--small" type="submit">
              Sign out
            </button>
          </form>
        </div>
      </SiteHeader>
    )}
    <main id="main" class="wrap">
      <slot />
    </main>
    <script>
      // Confirm the remembered role. The API enforces access either way; this
      // only decides which links to show.
      const rememberAdmin = (isAdmin: boolean) => {
        document.documentElement.toggleAttribute("data-admin", isAdmin);
        try {
          if (isAdmin) localStorage.setItem("dhoa:is-admin", "1");
          else localStorage.removeItem("dhoa:is-admin");
        } catch {}
      };
      if (document.querySelector("[data-admin-only]")) {
        fetch("/api/me", { credentials: "same-origin" })
          .then((r) => (r.ok ? r.json() : null))
          .then((me) =>
            rememberAdmin(
              !!me?.grants?.some(
                (g: { role: string; scope: string }) =>
                  g.role === "admin" && g.scope === "",
              ),
            ),
          );
      }
      document
        .querySelector<HTMLFormElement>("[data-sign-out]")
        ?.addEventListener("submit", async (event) => {
          event.preventDefault();
          await fetch("/api/auth/sign-out", {
            method: "POST",
            headers: { "content-type": "application/json" },
            body: "{}",
          });
          rememberAdmin(false);
          location.assign("/sign-in/");
        });
    </script>
  </body>
</html>
